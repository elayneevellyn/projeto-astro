---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Contato e Atendimento | Idiomas Sousa - PB"
  description="Entre em contato com nossa escola de idiomas em Sousa-PB. Cursos de Inglês, Espanhol, Francês, Italiano e Libras. WhatsApp (83) 99999-9999 e localização central."
  activeNav="contato"
>
  <!-- Page Hero Banner com banner-contato.jpg -->
  <section class="page-hero hero-page-banner hero-contato">
    <div class="hero-ambient-bg"></div>
    <div class="hero-light-sweep"></div>
    <div class="hero-light-beam"></div>
    <canvas class="hero-particles-canvas" aria-hidden="true"></canvas>

    <div class="content-container">
      <span class="eyebrow">Canais de Atendimento</span>
      <h1 class="hero-headline">
        Estamos prontos para atender você, <br>
        <span class="cursive-highlight">sem burocracia ou espera.</span>
      </h1>
      <p class="hero-subheading">
        Tire suas dúvidas sobre Inglês, Espanhol, Francês, Italiano e Libras. Fale com a secretaria pelo WhatsApp, faça-nos uma visita no Centro de Sousa ou preencha o formulário abaixo.
      </p>

      <div class="hero-cta-group">
        <Button href="https://wa.me/5583999999999?text=Ol%C3%A1%2C%20gostaria%20de%20falar%20com%20o%20atendimento" variant="primary" target="_blank" rel="noopener">
          Conversar no WhatsApp agora
        </Button>
        <Button href="#formulario" variant="ghost">
          Enviar formulário de interesse
        </Button>
      </div>
    </div>
  </section>

  <!-- Section 1: Cartões de Contato Rápido com Cópia (Canvas Gray Background) -->
  <section class="section-canvas">
    <div class="content-container">
      <div class="section-header">
        <span class="eyebrow">Informações Diretas</span>
        <h2>
          Canais rápidos de contato <br>
          <span class="cursive-highlight">com um clique.</span>
        </h2>
        <p>Você pode copiar os dados de atendimento ou clicar nos botões para iniciar a conversa.</p>
      </div>

      <div class="card-grid-3">
        <!-- Card WhatsApp -->
        <div class="feature-card">
          <div>
            <div class="card-icon-bubble icon-blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <span class="cursive-tag" style="color: var(--color-electric-blue);">Mais Rápido</span>
            <h3 class="feature-card-title" style="font-size: 20px;">WhatsApp</h3>
            <p class="feature-card-body" style="font-size: 15px; font-weight: 700; color: var(--color-primary-ink); margin-bottom: 12px;">
              (83) 99999-9999
            </p>
            <button class="btn-copy" type="button" data-copy="(83) 99999-9999" aria-label="Copiar número de telefone">
              📋 Copiar número
            </button>
          </div>
          <div class="feature-card-footer" style="margin-top: 20px;">
            <Button href="https://wa.me/5583999999999" variant="link" target="_blank" rel="noopener">Iniciar conversa &rsaquo;</Button>
          </div>
        </div>

        <!-- Card Endereço -->
        <div class="feature-card">
          <div>
            <div class="card-icon-bubble">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <span class="cursive-tag">Presencial</span>
            <h3 class="feature-card-title" style="font-size: 20px;">Endereço</h3>
            <p class="feature-card-body" style="font-size: 14.5px; margin-bottom: 12px;">
              Rua Principal, nº 100<br>Centro – Sousa-PB
            </p>
            <button class="btn-copy" type="button" data-copy="Rua Principal, nº 100 – Centro, Sousa-PB" aria-label="Copiar endereço completo">
              📋 Copiar endereço
            </button>
          </div>
          <div class="feature-card-footer" style="margin-top: 20px;">
            <Button href="#mapa" variant="link">Ver orientações &rsaquo;</Button>
          </div>
        </div>

        <!-- Card Horários -->
        <div class="feature-card">
          <div>
            <div class="card-icon-bubble icon-warm">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="cursive-tag" style="color: var(--color-ember);">Atendimento</span>
            <h3 class="feature-card-title" style="font-size: 20px;">Horários</h3>
            <p class="feature-card-body" style="font-size: 14px;">
              <strong>Segunda a Sexta:</strong> 08:00 às 18:00<br>
              <strong>Sábado:</strong> 08:00 às 12:00
            </p>
          </div>
          <div class="feature-card-footer" style="margin-top: 20px;">
            <Button href="/precos-horarios#horarios" variant="link">Ver detalhes de turnos &rsaquo;</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Formulário de Mensagem (White Background) -->
  <section class="section-white" id="formulario">
    <div class="content-container" style="max-width: 820px;">
      <div class="section-header text-center">
        <span class="eyebrow">Mensagem Online</span>
        <h2>
          Envie sua dúvida para a equipe, <br>
          <span class="cursive-highlight">nós respondemos rapidinho!</span>
        </h2>
        <p>Preencha os campos abaixo. Ao clicar em enviar, você será direcionado para o nosso WhatsApp com a mensagem formatada.</p>
      </div>

      <div class="feature-card card-navy" style="padding: 36px;">
        <div id="form-feedback" class="form-feedback"></div>

        <form id="contact-form" class="clean-form">
          <div class="form-group">
            <label for="nome" class="form-label">Nome Completo</label>
            <input type="text" id="nome" name="nome" class="form-input" placeholder="Ex: Maria da Silva" required>
          </div>

          <div class="card-grid-2" style="gap: 16px;">
            <div class="form-group">
              <label for="whatsapp" class="form-label">WhatsApp com DDD</label>
              <input type="tel" id="whatsapp" name="whatsapp" class="form-input" placeholder="(83) 99999-9999" required>
            </div>

            <div class="form-group">
              <label for="idioma" class="form-label">Idioma de Interesse</label>
              <select id="idioma" name="idioma" class="form-select">
                <option value="Inglês">Inglês</option>
                <option value="Espanhol">Espanhol</option>
                <option value="Francês">Francês</option>
                <option value="Italiano">Italiano</option>
                <option value="Libras">Libras (Língua Brasileira de Sinais)</option>
                <option value="Mais de um idioma">Mais de um idioma / Outro</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="modalidade" class="form-label">Modalidade Preferida</label>
            <select id="modalidade" name="modalidade" class="form-select">
              <option value="Grupo">Turma em Grupo (a partir de R$ 150/mês)</option>
              <option value="Individual VIP">Aulas Individuais VIP</option>
              <option value="Ainda não decidi">Ainda não decidi (preciso de orientação)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="mensagem" class="form-label">Mensagem ou Dúvida (Opcional)</label>
            <textarea id="mensagem" name="mensagem" class="form-textarea" placeholder="Conte-nos qual o seu objetivo ou qual horário você prefere..."></textarea>
          </div>

          <Button type="submit" variant="primary" style="width: 100%; padding: 14px; font-size: 16px; margin-top: 6px;">
            Enviar mensagem e falar no WhatsApp
          </Button>
        </form>
      </div>
    </div>
  </section>

  <!-- Section 3: Localização e Orientações (Canvas Gray Background) -->
  <section class="section-canvas" id="mapa">
    <div class="content-container">
      <div class="callout-banner callout-themed-contato">
        <div class="callout-content">
          <span class="cursive-tag">★ Venha nos visitar</span>
          <h3>Como chegar à nossa escola em Sousa-PB.</h3>
          <p>
            Estamos situados no coração de Sousa, na Rua Principal, nº 100. Ponto de fácil acesso por transporte público ou particular, com estacionamento nas imediações e recepção acolhedora com café.
          </p>
          <div style="display: flex; gap: 14px; flex-wrap: wrap;">
            <Button href="https://wa.me/5583999999999?text=Ol%C3%A1%2C%20estou%20a%20caminho%20da%20escola%20em%20Sousa" variant="primary" target="_blank" rel="noopener">Avisar que estou a caminho</Button>
            <Button href="/escola" variant="ghost">Conhecer nossa estrutura</Button>
          </div>
        </div>

        <div class="info-items-grid">
          <div class="info-item-box">
            <div class="info-item-label">Cidade</div>
            <div class="info-item-val">Sousa – PB</div>
          </div>
          <div class="info-item-box">
            <div class="info-item-label">Bairro</div>
            <div class="info-item-val">Centro</div>
          </div>
          <div class="info-item-box">
            <div class="info-item-label">Logradouro</div>
            <div class="info-item-val">Rua Principal, nº 100</div>
          </div>
          <div class="info-item-box">
            <div class="info-item-label">Café de Recepção</div>
            <div class="info-item-val">Sempre à sua espera</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
