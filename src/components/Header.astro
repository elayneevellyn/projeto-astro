---
import Button from './Button.astro';

interface Props {
  activeNav?: 'inicio' | 'cursos' | 'escola' | 'precos-horarios' | 'contato';
}

const { activeNav = 'inicio' } = Astro.props;
---

<!-- Global Navigation Header Component -->
<header class="global-header">
  <div class="nav-container">
    <a href="/" class="nav-brand" aria-label="Página inicial Idiomas Sousa">
      <div class="brand-icon-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </div>
      <div>
        <span class="brand-title">Idiomas Sousa</span>
        <span class="brand-subtitle">aprendizado com leveza</span>
      </div>
    </a>

    <nav class="nav-menu" aria-label="Menu principal">
      <a href="/" class:list={['nav-link', { active: activeNav === 'inicio' }]}>Início</a>
      <a href="/cursos" class:list={['nav-link', { active: activeNav === 'cursos' }]}>Cursos</a>
      <a href="/escola" class:list={['nav-link', { active: activeNav === 'escola' }]}>A Escola</a>
      <a href="/precos-horarios" class:list={['nav-link', { active: activeNav === 'precos-horarios' }]}>Preços e Horários</a>
      <a href="/contato" class:list={['nav-link', { active: activeNav === 'contato' }]}>Contato</a>
    </nav>

    <div class="nav-actions">
      <Button href="https://wa.me/5583999999999" variant="nav-cta" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 18.08c-1.49 0-2.95-.4-4.23-1.16l-.3-.18-3.14.82.84-3.06-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.52 3.68-8.2 8.2-8.2 2.19 0 4.25.85 5.8 2.4 1.55 1.55 2.41 3.61 2.4 5.8 0 4.53-3.67 8.21-8.11 8.21z"/>
        </svg>
        WhatsApp
      </Button>
      <button class="mobile-toggle" aria-label="Abrir menu de navegação" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
